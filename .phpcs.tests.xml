<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<!-- Extend the A8CSP tests-profile ruleset. -->
	<rule ref="./vendor/a8csp/configs/php/quality-assurance/phpcs.tests.dist.xml"/>

	<!-- Check that the proper text domain is used everywhere, in case a future test fixture calls __()/_e(). -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="a8csp-project-template"/>
			</property>
		</properties>
	</rule>
</ruleset>
