# Theme and Plugin handling
#
# Ignore the parent, but explicitly exclude (from ignore) any themes, mu-plugins, or plugins
# we wish to source control. Everything else under these directories is installed, not tracked.
#
plugins/*
!plugins/.gitkeep

mu-plugins/*
!mu-plugins/mu-loader.php
!mu-plugins/a8csp-project-template-features

themes/*
!themes/a8csp-project-template

# Other wp-content exclusions: WordPress core manages these at runtime, not this repo. The
# root-level /languages/ is core/community translation downloads, distinct from the tracked
# per-component languages/ directories under themes/ and mu-plugins/.
/languages/*
upgrade/*
uploads/*
debug.log

### Composer ###
composer.phar
/vendor/

### Node ###
node_modules/
npm-debug.log*
.npm
.eslintcache
.stylelintcache

### Tests ###
# phpunit result cache and Playwright artifacts/storage-state; both regenerate per run.
tests/.cache/

### wp-env ###
# A generated repository's derived port block may collide with another checked-out repository's;
# these local-precedence override files resolve it without touching the committed configs.
.wp-env*.override.json

### OS noise ###
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

### Editor / IDE ###
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
