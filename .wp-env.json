{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "phpVersion": "8.5",
  "port": 8894,
  "testsEnvironment": false,
  "mappings": {
    "wp-content/themes/a8csp-project-template": "./themes/a8csp-project-template",
    "wp-content/mu-plugins": "./mu-plugins",
    "wp-content/project": "."
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp theme activate a8csp-project-template && wp-env run cli wp rewrite structure '/%postname%/' && wp-env run cli wp rewrite flush"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_DISPLAY": false,
    "WP_DEBUG_LOG": true,
    "SCRIPT_DEBUG": true
  }
}
