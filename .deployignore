# Site deploy exclusions — filters what a deploy actually pushes to the host; the git tree
# itself stays deploy-agnostic (repo shape doesn't encode deploy policy, this file does).
# Asset sources and sourcemaps deploy deliberately: we work open, and shipped sources keep
# the live site debuggable.

.git*
.editorconfig
.gitignore
.deployignore
node_modules
vendor
tests
.github

.wp-env*.json
playwright.config.js
phpunit.dist.xml
.phpcs.xml
.phpcs.tests.xml
.phpstan.neon
eslint.config.mjs
stylelint.config.js
postcss.config.js

package.json
package-lock.json
composer.json
composer.lock

LICENSE
README.md

# Agent context files team51-cli copies into every new project repository.
AGENTS.md
CLAUDE.md
.agents

# Core-folder protection: deploy tooling should never wipe or shadow these WordPress
# content directories even if a filter pattern elsewhere matches too broadly.
!themes
!mu-plugins
!plugins
!uploads
